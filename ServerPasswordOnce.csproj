<Project Sdk="Microsoft.NET.Sdk">

	<!-- Shared build layer. Two lines per props file, and only one of them ever matches: locally
	     Workspace is a sibling of this folder, in CI it is checked out INTO this repo. -->
	<Import Project="$(MSBuildThisFileDirectory)../Workspace/build/GameRefs.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/GameRefs.props')" />
	<Import Project="$(MSBuildThisFileDirectory)Workspace/build/GameRefs.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/GameRefs.props')" />
	<Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Deploy.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Deploy.props')" />
	<Import Project="$(MSBuildThisFileDirectory)Workspace/build/Deploy.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/Deploy.props')" />
	<Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props')" />
	<Import Project="$(MSBuildThisFileDirectory)Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/Hardening.props')" />
	<Import Project="$(MSBuildThisFileDirectory)../Workspace/build/ModVersion.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/ModVersion.props')" />
	<Import Project="$(MSBuildThisFileDirectory)Workspace/build/ModVersion.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/ModVersion.props')" />
	<!-- ServerSync, merged into the DLL by ILRepack. The reference and the merge live in ServerSync.props;
	     remove both lines for a mod without server-synced config. -->
	<Import Project="$(MSBuildThisFileDirectory)../Workspace/build/ServerSync.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/ServerSync.props')" />
	<Import Project="$(MSBuildThisFileDirectory)Workspace/build/ServerSync.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/ServerSync.props')" />

	<PropertyGroup>
		<!-- Valheim runs on Mono with the .NET 4.x profile; net48 is what BepInEx 5 plugins target. -->
		<TargetFramework>net48</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<!-- Off on purpose: the SDK's global usings pull System.Net.Http and System.Threading.Tasks into
		     every file, which a net48 Unity plugin neither needs nor always resolves. Usings are written out. -->
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>ServerPasswordOnce</RootNamespace>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyName>ServerPasswordOnce</AssemblyName>
		<!-- The real version comes from the release tag as -p:Version and reaches BepInPlugin through
		     DooDesch.ModVersion.Current (Workspace/build/ModVersion.props). -->
		<Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
	</PropertyGroup>

</Project>
