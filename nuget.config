<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Travels with every mod repo AND with the Workspace. NuGet reads the nearest nuget.config walking
    up from the project folder; locally Workspace is a sibling of the mod, so a config inside
    Workspace is never on a mod's path - hence one copy per repo. In CI Workspace sits inside the
    mod repo and the repo-root copy covers both.

    <clear /> so a user-level config with a stale or private feed cannot change what a build
    resolves. nuget.org only: JotunnLib, the publicizer and ILRepack all live there, and NuGet
    contacts every listed source on a cold cache (CI, a fresh machine), so an unreachable second
    feed fails the restore with NU1301 even when every package is on nuget.org. Add the BepInEx
    feed (https://nuget.bepinex.dev/v3/index.json) only together with the first package that
    needs it, and then with a packageSourceMapping that sends "*" to nuget.org and only the
    concrete ids to that feed - BepInEx.AssemblyPublicizer.MSBuild is NOT on the BepInEx feed
    (404 there, nuget.org only), so a plain "BepInEx.*" pattern would break restore.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
